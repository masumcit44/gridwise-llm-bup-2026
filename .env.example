# GridWise LLM — Environment Configuration
# Copy to .env and fill in values. Never commit real secrets.

APP_NAME=GridWise LLM BUP 2026
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# Language-model configuration (used by later implementation tasks)
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30

# Runtime LLM provider chain (primary -> secondary failover).
# Never put real API keys in this file; fill them in your local .env only.
LLM_PRIMARY_PROVIDER=groq
LLM_SECONDARY_PROVIDER=gemini
GROQ_API_KEY=
GROQ_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
LLM_REPAIR_ATTEMPTS=1

# Performance targets
REQUEST_TIMEOUT_SECONDS=30
HEALTH_READY_TIMEOUT_SECONDS=60